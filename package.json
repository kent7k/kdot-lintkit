{
  "name": "kdot-lintkit",
  "version": "0.0.0",
  "private": true,
  "description": "LintKit – shared lint/format toolkit (prettier / eslint / stylelint / markdownlint / locale)",
  "author": "kent7k",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10 <11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lintkit/kdot-lintkit.git"
  },
  "scripts": {
    "publish:all": "pnpm -r publish --no-git-checks",
    "version:patch": "pnpm -r exec npm version patch --no-git-tag-version"
  }
}
