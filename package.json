{
  "name": "kdot-lintkit",
  "version": "0.0.0",
  "private": true,
  "description": "LintKit – shared lint/format toolkit (prettier / eslint / stylelint / markdownlint / locale)",
  "author": "kent7k",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10 <11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kent7k/kdot-lintkit.git"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "publish:all": "node scripts/publish.mjs",
    "version:patch": "pnpm -r exec npm version patch --no-git-tag-version"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1"
  }
}
