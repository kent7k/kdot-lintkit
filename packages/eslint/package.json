{
  "name": "@kent7k/lintkit-eslint",
  "version": "1.0.1",
  "private": false,
  "license": "MIT",
  "author": "kent7k",
  "type": "module",
  "description": "LintKit – shared ESLint flat configs (base / node / next / flat)",
  "bin": {
    "lintkit-eslint": "bin/lintkit-eslint.mjs"
  },
  "files": [
    "*.mjs",
    "bin",
    "ignore"
  ],
  "exports": {
    "./next": "./next.mjs",
    "./base": "./base.mjs",
    "./node": "./node.mjs",
    "./flat": "./flat.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kent7k/kdot-lintkit.git",
    "directory": "packages/eslint"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.32.0",
    "@next/eslint-plugin-next": "^16.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sort-export-all": "^2.0.0",
    "globals": "17.13.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": ">=5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
