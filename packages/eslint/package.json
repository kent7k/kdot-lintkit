{
  "name": "@lintkit/eslint",
  "version": "0.1.3",
  "private": false,
  "license": "MIT",
  "author": "kent7k",
  "type": "module",
  "description": "LintKit – shared ESLint flat configs (base / node / next / flat)",
  "bin": {
    "lintkit-eslint": "bin/lintkit-eslint.mjs"
  },
  "files": [
    "*.mjs",
    "bin",
    "ignore"
  ],
  "exports": {
    "./next": "./next.mjs",
    "./base": "./base.mjs",
    "./node": "./node.mjs",
    "./flat": "./flat.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lintkit/kdot-lintkit.git",
    "directory": "packages/eslint"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@eslint/compat": "1.3.2",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.32.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "eslint-config-next": "^15.5.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-sort-export-all": "^2.0.0",
    "globals": "16.3.0"
  },
  "peerDependencies": {
    "eslint": "9.32.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.38.0"
  }
}
